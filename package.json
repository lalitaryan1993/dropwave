{
  "name": "dropwave",
  "productName": "DropWave",
  "version": "1.11.0",
  "description": "Your Android phone on your PC, and files to any PC, phone or TV on your own Wi-Fi. No cloud, no account.",
  "main": "electron/main.cjs",
  "author": "LALIT ARYAN",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:second": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 DROPWAVE_PROFILE=second DROPWAVE_PORT=47832 electron .",
    "build": "vite build",
    "start": "electron .",
    "test:engine": "node test/engine.test.cjs",
    "icon": "electron scripts/process-icons.cjs",
    "vcam": "native\\vcam\\build.cmd",
    "kvm": "native\\kvm\\build.cmd",
    "dist": "npm run vcam && npm run kvm && vite build && electron-builder --win nsis",
    "test:web": "node test/web.test.cjs",
    "test": "node test/engine.test.cjs && node test/web.test.cjs && node test/flow.test.cjs",
    "dist:store": "npm run vcam && npm run kvm && vite build && electron-builder --win appx"
  },
  "build": {
    "appId": "com.dropwave.app",
    "productName": "DropWave",
    "copyright": "DropWave",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/kvm",
        "to": "kvm",
        "filter": [
          "dwkvm.exe"
        ]
      },
      {
        "from": "build/vcam",
        "to": "vcam",
        "filter": [
          "dwcam.exe",
          "DropWaveCam.dll"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DropWave",
      "include": "build/installer.nsh",
      "artifactName": "DropWave-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lalitaryan1993",
        "repo": "dropwave"
      }
    ],
    "appx": {
      "applicationId": "DropWave",
      "identityName": "LalitAryan.DropWave",
      "publisher": "CN=440102B7-C290-40D7-BD36-2E7CDFD1E87A",
      "publisherDisplayName": "Lalit Aryan",
      "displayName": "DropWave",
      "backgroundColor": "#0B0D14",
      "languages": [
        "en-US",
        "hi-IN"
      ],
      "artifactName": "DropWave-Store-${version}.${ext}",
      "minVersion": "10.0.19041.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalitaryan1993/dropwave.git"
  }
}
